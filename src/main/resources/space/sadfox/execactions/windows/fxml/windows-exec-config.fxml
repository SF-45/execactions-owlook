<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>


<AnchorPane prefHeight="475.0" prefWidth="560.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <VBox layoutY="291.0" spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
         <children>
            <HBox spacing="10.0">
               <children>
                  <RadioButton fx:id="singleExec" mnemonicParsing="false" text="Single exec">
                     <toggleGroup>
                        <ToggleGroup fx:id="execMode" />
                     </toggleGroup>
                  </RadioButton>
                  <RadioButton fx:id="multiExec" mnemonicParsing="false" text="Multi exec" toggleGroup="$execMode" />
               </children>
            </HBox>
            <Separator />
            <HBox spacing="10.0">
               <children>
                  <RadioButton fx:id="cmdShell" mnemonicParsing="false" text="CMD">
                     <toggleGroup>
                        <ToggleGroup fx:id="shell" />
                     </toggleGroup>
                  </RadioButton>
                  <RadioButton fx:id="powershellShell" mnemonicParsing="false" text="PowerShell" toggleGroup="$shell" />
               </children>
            </HBox>
         </children>
      </VBox>
      <TextArea fx:id="commandTextArea" layoutX="14.0" layoutY="14.0" prefHeight="380.0" prefWidth="700.0" AnchorPane.bottomAnchor="87.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />
   </children>
</AnchorPane>
